# ==============================================================================
# Cielo Cafe and Restro - Production & Staging Environment Settings
# ==============================================================================
# For production: set APP_ENV=production, APP_DEBUG=false, and APP_URL=https://yourdomain.com
APP_NAME="Cielo Cafe & Restro"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8001

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# For shared hosting / cPanel / VPS: set DB_CONNECTION=mysql and provide credentials.
# For local testing / standalone: use DB_CONNECTION=sqlite with database/cielo.sqlite
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/cielo.sqlite
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------------------
# SMS / OTP Provider (MSG91 / Fast2SMS / Firebase)
# ------------------------------------------------------------------------------
OTP_PROVIDER=mock
OTP_API_KEY=
OTP_SENDER_ID=CIELOC

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
