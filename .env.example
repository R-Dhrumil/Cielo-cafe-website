# Cielo Cafe and Restro - Environment Settings
APP_NAME="Cielo Cafe & Restro"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (mysql for production, sqlite for local/testing)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/cielo.sqlite
DB_USERNAME=root
DB_PASSWORD=

# SMS / OTP Provider (MSG91 / Fast2SMS / Firebase)
OTP_PROVIDER=mock
OTP_API_KEY=
OTP_SENDER_ID=CIELOC

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
